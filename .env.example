# ---- copy to .env and fill in. Never commit .env ----
DOMAIN=yourdomain.com                 # use "localhost" to test on your own computer
BASE_URL=https://yourdomain.com       # used in emails and WhatsApp document links
SECRET_KEY="change-me"                         # long random text, e.g. run: openssl rand -hex 32

# first admin account, created on first start (change the password!)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# database (used by docker-compose)
MYSQL_DATABASE=immaculate
MYSQL_USER=ic
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# who receives new-inquiry alerts
ADMIN_EMAIL=you@yourdomain.com
ADMIN_WHATSAPP=923368149077

# outgoing email (SMTP). Gmail: smtp.gmail.com, port 587, an App Password
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# WhatsApp Business Cloud API (Meta). Leave empty to skip WhatsApp notifications
WA_TOKEN=
WA_PHONE_ID=

# optional
COMPANY_NAME=Immaculate Crest
COMPANY_ADDRESS=Karachi, Pakistan|WhatsApp +92 336 8149077|Instagram 8immaculatecrest
MAX_FILE_MB=25
MAX_VIDEO_MB=200
